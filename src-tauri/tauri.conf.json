{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dashboard",
  "version": "0.1.0",
  "identifier": "com.dashboard.app",
  "build": {
    "frontendDist": "https://dashboard-app-jxlb.onrender.com",
    "devUrl": "https://dashboard-app-jxlb.onrender.com"
  },
  "app": {
    "windows": [
      {
        "title": "Dashboard",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "fileDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
